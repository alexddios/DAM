// Diagrama de Clases MVP
digraph {
	rankdir=TB size="10,10"
	node [fontname=Helvetica fontsize=10 shape=record]
	edge [fontname=Helvetica fontsize=10]
	IView [label="{\<\<interface\>\>\nIView|+ setPresenter(p: IPresenter)\n+ updateCount(count: int)}"]
	IModel [label="{\<\<interface\>\>\nIModel|+ startSimulation()\n+ setPresenter(p: IPresenter)}"]
	IPresenter [label="{\<\<interface\>\>\nIPresenter|+ onSimulationStarted()\n+ updateCounter(value: int)}"]
	MyView [label="{MyView|- presenter: IPresenter\n- resultLabel: JLabel\n- startButton: JButton|+ MyView()\n+ setPresenter(p: IPresenter)\n+ updateCount(count: int)}"]
	MyModel [label="{MyModel|- presenter: IPresenter\n- resource: Resource|+ MyModel()\n+ startSimulation()\n+ setPresenter(p: IPresenter)}"]
	MyPresenter [label="{MyPresenter|- view: IView\n- model: IModel|+ MyPresenter(v: IView, m: IModel)\n+ onSimulationStarted()\n+ updateCounter(value: int)}"]
	Resource [label="{Resource|- count: int = 0|+ getCount(): int\n+ add()\n+ remove()}"]
	Producer [label="{Producer|- resource: Resource\n- model: IModel|+ Producer(r: Resource, m: IModel)\n+ run()}"]
	Consumer [label="{Consumer|- resource: Resource\n- model: IModel|+ Consumer(r: Resource, m: IModel)\n+ run()}"]
	Runnable [label="{\<\<interface\>\>\nRunnable|+ run()}"]
	MyView -> IView [arrowhead=empty style=dashed]
	MyModel -> IModel [arrowhead=empty style=dashed]
	MyPresenter -> IPresenter [arrowhead=empty style=dashed]
	Producer -> Runnable [arrowhead=empty style=dashed]
	Consumer -> Runnable [arrowhead=empty style=dashed]
	MyPresenter -> IView [label="- view" arrowhead=vee]
	MyPresenter -> IModel [label="- model" arrowhead=vee]
	MyView -> IPresenter [label="- presenter" arrowhead=vee]
	MyModel -> IPresenter [label="- presenter" arrowhead=vee]
	Resource -> MyModel [arrowhead=diamond dir=forward]
	MyModel -> Producer [label=instancia arrowhead=vee style=dashed]
	MyModel -> Consumer [label=instancia arrowhead=vee style=dashed]
	Producer -> Resource [label="- resource" arrowhead=vee]
	Consumer -> Resource [label="- resource" arrowhead=vee]
}
